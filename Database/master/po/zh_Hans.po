msgstr ""
"十分美观的装饰品。\n"
"除养眼之外\n"
"并无特别的作用。"

msgid "itp_dsc2_0003"
msgstr ""
"最新款的香薰机。\n"
"令人安心的设计，\n"
"无需点火即可使用。"

msgid "itp_dsc2_0006"
msgstr ""
"一口就能吃下的小点心。\n"
"用来解决嘴馋\n"
"再合适不过。"

msgid "itp_dsc2_0007"
msgstr ""
"大大的点心。\n"
"适合和朋友\n"
"一起分着吃。"

msgid "itp_dsc2_0008"
msgstr ""
"温德米尔的特产苹果。\n"
"吃的不够干净\n"
"会被芙蕾雅训斥。"

msgid "itp_dsc2_0009"
msgstr ""
"稀有的上等下酒菜。\n"
"在喜欢喝酒的女性中颇具人气。"

msgid "itp_dsc2_0010"
msgstr ""
"从拉格纳的海里捞上来的新鲜水母。\n"
"Q弹嫩滑的口感，\n"
"令人欲罢不能。"

msgid "itp_dsc2_0011"
msgstr ""
"在路边的店铺购买的热狗。\n"
"两个人一起吃\n"
"会格外美味。"

msgid "itp_dsc2_0012"
msgstr ""
"连边边角角都十分美味的披萨。\n"
"虽然味道很小孩子气，\n"
"但就是很能勾起食欲。"

msgid "itp_dsc2_0013"
msgstr ""
"熔岩似的咖喱，辣得吓人。\n"
"要是不小心吃上一口，\n"
"估计能从嘴里喷出火来吧？"

msgid "itp_dsc2_0014"
msgstr ""
"娘娘中餐店的固定菜品。\n"
"味道与众不同，\n"
"十分受女性欢迎。"

msgid "itp_dsc2_0015"
msgstr ""
"记录着各种点子的笔记。\n"
"遇到困难的时候不妨掏出来看看。"

msgid "itp_dsc2_0016"
msgstr ""
"汇集了伟大音乐家的作品的唱片。\n"
"听过的人必定\n"
"受益匪浅！"

msgid "itp_dsc2_0017"
msgstr ""
"做工精细的战机模型。\n"
"可完美还原真实战机的\n"
"三段变形。"

msgid "itp_dsc2_0018"
msgstr ""
"又丑又萌的小周边。\n"
"仔细一看，\n"
"跟某人的手机简直一模一样！"

msgid "itp_dsc2_0020"
msgstr ""
"包装得无比用心的巧克力。\n"
"好好品尝藏在心里的\n"
"浓情蜜意吧。"

msgid "itp_dsc2_0021"
msgstr ""
"用心包装过的点心盒。\n"
"里面装着男生笨拙的心意。"

msgid "itp_dsc2_0022"
msgstr ""
"任谁收到都会很高兴的礼物。\n"
"不过，谁知道里面装着什么呢。"

