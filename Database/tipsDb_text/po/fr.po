msgid "tips_0080_title"
msgstr "C'est quoi la pièce déco ?"

msgid "tips_0080_msg"
msgstr ""
"Utilise les objets déco pour créer\n"
"la pièce de tes rêves !"

msgid "tips_0081_title"
msgstr "C'est quoi l'amélioration de Valkyrie ?"

msgid "tips_0081_msg"
